<?xml version="1.0" encoding="utf-8"?>
<Afflictions>

  <!-- ============================================================
       序列状态（常驻 buff）
       注意：每个 Affliction 内所有 Effect 的强度区间不能重叠，
       否则引擎只会启用其中一个（v0.1 的 bug 就出在这里）。
       ============================================================ -->

  <Affliction name="" identifier="lotm_seq9" description="" isbuff="true" limbspecific="false" maxstrength="100" MedicalSkillGain="0">
    <Description textidentifier="afflictiondescription.lotm_seq9" target="Self" />
    <Effect minstrength="0" maxstrength="100" strengthchange="0" minbodytint="90,130,255,25" maxbodytint="90,130,255,55">
      <StatValue stattype="MaximumHealthMultiplier" minvalue="0.05" maxvalue="0.05" />
      <StatValue stattype="SightRangeMultiplier" minvalue="0.10" maxvalue="0.10" />
    </Effect>
    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="256,896,128,128" color="90,130,255,255" origin="0,0" />
  </Affliction>

  <Affliction name="" identifier="lotm_seq8" description="" isbuff="true" limbspecific="false" maxstrength="100" MedicalSkillGain="0">
    <Description textidentifier="afflictiondescription.lotm_seq8" target="Self" />
    <Effect minstrength="0" maxstrength="100" strengthchange="0" minspeedmultiplier="1.0" maxspeedmultiplier="1.12" minbodytint="240,220,120,25" maxbodytint="240,220,120,60" resistancefor="damage" minresistance="0" maxresistance="0.10">
      <StatValue stattype="MaximumHealthMultiplier" minvalue="0.15" maxvalue="0.15" />
      <StatValue stattype="MeleeAttackMultiplier" minvalue="0.20" maxvalue="0.20" />
      <StatValue stattype="HoldBreathMultiplier" minvalue="0.30" maxvalue="0.30" />
    </Effect>
    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="384,896,128,128" color="240,220,120,255" origin="0,0" />
  </Affliction>

  <Affliction name="" identifier="lotm_seq7" description="" isbuff="true" limbspecific="false" maxstrength="100" MedicalSkillGain="0">
    <Description textidentifier="afflictiondescription.lotm_seq7" target="Self" />
    <Effect minstrength="0" maxstrength="100" strengthchange="0" minspeedmultiplier="1.0" maxspeedmultiplier="1.18" minbodytint="255,150,80,25" maxbodytint="255,150,80,60" resistancefor="damage" minresistance="0" maxresistance="0.15">
      <StatValue stattype="MaximumHealthMultiplier" minvalue="0.25" maxvalue="0.25" />
      <StatValue stattype="MeleeAttackMultiplier" minvalue="0.35" maxvalue="0.35" />
      <StatValue stattype="HoldBreathMultiplier" minvalue="0.50" maxvalue="0.50" />
