    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="640,896,128,128" color="200,200,120,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       幻术：短时间让怪物忽略自己（序列7）
       ============================================================ -->
  <Affliction name="" identifier="lotm_illusion" description="" isbuff="true" limbspecific="false" maxstrength="100" MedicalSkillGain="0">
    <Description textidentifier="afflictiondescription.lotm_illusion" target="Self" />
    <Effect minstrength="0" maxstrength="100" strengthchange="0">
      <AbilityFlag flagtype="IgnoredByEnemyAI" />
    </Effect>
    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="896,896,128,128" color="150,120,220,255" origin="0,0" />
  </Affliction>
  <!-- ============================================================
       纸人护佑：纸人替身触发后的短暂庇护，抵挡水压与持续伤害
       ============================================================ -->
  <Affliction name="" identifier="lotm_paperward" description="" isbuff="true" limbspecific="false" maxstrength="100" MedicalSkillGain="0">
