    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="0,896,128,128" color="255,150,80,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       灵视：主动开关，开启时由脚本持续消耗灵性
       ============================================================ -->
  <Affliction name="" identifier="lotm_spiritvision" description="" isbuff="true" limbspecific="false" maxstrength="100" MedicalSkillGain="0">
    <Description textidentifier="afflictiondescription.lotm_spiritvision" target="Self" />
    <Effect minstrength="0" maxstrength="100" strengthchange="0" ThermalOverlayRange="900" ThermalOverlayColor="120,160,255,150" />
    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="768,896,128,128" color="120,200,255,255" origin="0,0" />
  </Affliction>

  <!-- 灵性耗尽强行关闭灵视后的短暂后遗症 -->
  <Affliction name="" identifier="lotm_visionsick" description="" isbuff="true" limbspecific="false" indicatorlimb="Head" activationthreshold="0" maxstrength="100" treatmentthreshold="1000" showinhealthscannerthreshold="0">
    <Description textidentifier="afflictiondescription.lotm_visionsick" target="Self" />
    <Effect minstrength="0" maxstrength="100" strengthchange="-2" minspeedmultiplier="1.0" maxspeedmultiplier="0.85" />
    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="896,896,128,128" color="160,120,200,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       灵性：施法资源，缓慢自然回复
       ============================================================ -->
  <Affliction name="" identifier="lotm_spirituality" description="" isbuff="true" limbspecific="false" maxstrength="100" MedicalSkillGain="0">
    <Description textidentifier="afflictiondescription.lotm_spirituality" target="Self" />
    <Effect minstrength="0" maxstrength="100" strengthchange="0.5" />
    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="512,896,128,128" color="150,220,255,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       疯狂：不会自然衰减。区间必须互不重叠。
       ============================================================ -->
  <Affliction name="" identifier="lotm_madness" description="" isbuff="true" limbspecific="false" indicatorlimb="Head" activationthreshold="0" maxstrength="100" treatmentthreshold="1000" showinhealthscannerthreshold="0">
    <Description textidentifier="afflictiondescription.lotm_madness" target="Self" />
    <Effect minstrength="0" maxstrength="39" strengthchange="0" />
    <Effect minstrength="40" maxstrength="69" strengthchange="0" minspeedmultiplier="1.0" maxspeedmultiplier="0.90" />
    <Effect minstrength="70" maxstrength="100" strengthchange="0" minspeedmultiplier="1.0" maxspeedmultiplier="0.82">
      <StatusEffect target="Character" interval="12" disabledeltatime="true">
        <Affliction identifier="psychosis" amount="2" />
      </StatusEffect>
    </Effect>
    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="640,896,128,128" color="180,60,200,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
